<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Takoboto</AssemblyName>
    <RootNamespace>TakobotoApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <Product>Takoboto (portable)</Product>
    <Description>Takoboto Japanese dictionary - portable desktop edition</Description>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- app.ico is generated from your own Takoboto installer by tools\prepare-from-original.ps1 -->
  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- the original dictionary engine (portable class library); not part of this repository -->
    <Reference Include="Takoboto.Database">
      <HintPath>..\extracted\app\Takoboto.Database.dll</HintPath>
    </Reference>
    <!-- flags, logos: generated/copied from your own Takoboto installer by the prepare script -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckEngine" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\extracted\app\Takoboto.Database.dll')"
           Text="Takoboto.Database.dll was not found. Run tools\prepare-from-original.ps1 first (see README.md)." />
  </Target>

</Project>
