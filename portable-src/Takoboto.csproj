<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Takoboto</AssemblyName>
    <RootNamespace>TakobotoApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <Product>Takoboto (portable)</Product>
    <Description>Takoboto Japanese dictionary - portable desktop edition</Description>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- app.ico: the green mascot icon (made by tools\make_ico.ps1) -->
  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- the original dictionary engine (portable class library, by the author of Takoboto), kept in lib\ -->
    <Reference Include="Takoboto.Database">
      <HintPath>lib\Takoboto.Database.dll</HintPath>
    </Reference>
    <!-- flags, logos -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="Assets.%(Filename)%(Extension)" />
    <!-- the icon again, as a resource: the window icon is recoloured with the colour scheme -->
    <EmbeddedResource Include="app.ico" LogicalName="Assets.app.ico" />
    <!-- the strokes of the kana (KanjiVG) for the handwriting recognition -->
    <EmbeddedResource Include="Assets\kana-strokes.txt" LogicalName="Assets.kana-strokes.txt" />
  </ItemGroup>

  <Target Name="CheckEngine" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('lib\Takoboto.Database.dll')"
           Text="portable-src\lib\Takoboto.Database.dll is missing: it is part of the repository (or run tools\prepare-from-original.ps1)." />
  </Target>

</Project>
