<Window x:Class="TakobotoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Takoboto" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource PageBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <!-- Root: the zoom of the whole interface (Settings > Size of the interface) is a layout transform of this grid -->
  <Grid x:Name="Root">
    <Grid.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="0.85" ScaleY="0.85"/></Grid.LayoutTransform>
    <Grid x:Name="Main">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
  
      <!-- sidebar -->
      <!-- not painted: the same colour as the page, divided from it and into groups by thin lines only -->
      <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="20,22,12,22">
              <Image x:Name="Logo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="Takoboto" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource SidebarFg}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,14">
            <StackPanel>
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" GroupName="nav" Checked="Nav_Changed" Click="Nav_Changed"/>
              <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" GroupName="nav" Checked="Nav_Changed" Click="Nav_Changed"/>
            </StackPanel>
          </Border>
          <StackPanel>
            <RadioButton x:Name="NavSearch" Style="{StaticResource NavItem}" Tag="&#xE721;" Content="Search" GroupName="nav" IsChecked="True" Checked="Nav_Changed" Click="Nav_Changed"/>
            <RadioButton x:Name="NavGrammar" Style="{StaticResource NavItem}" Tag="&#xE82D;" Content="Grammar" GroupName="nav" Visibility="Collapsed" Checked="Nav_Changed" Click="Nav_Changed"/>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="History" GroupName="nav" Checked="Nav_Changed" Click="Nav_Changed"/>
            <RadioButton x:Name="NavFavorites" Style="{StaticResource NavItem}" Tag="&#xE734;" Content="Favorites" GroupName="nav" Checked="Nav_Changed" Click="Nav_Changed"/>
            <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" Tag="&#xE14C;" Content="My lists" GroupName="nav" Checked="Nav_Changed" Click="Nav_Changed"/>
          </StackPanel>
        </DockPanel>
      </Border>
  
      <!-- pages are added here by code -->
      <Grid x:Name="Host" Grid.Column="1"/>
    </Grid>

    <!-- dialog layer (Settings, About): everything behind goes a little grey; X, Esc or a click outside closes it -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Panel.ZIndex="100">
      <Border Background="#59000000" MouseLeftButtonDown="Scrim_Click"/>
      <Border x:Name="Dialog" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" Width="600"
              Background="{DynamicResource PageBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="Dialog_MouseDown">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.38"/></Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="20,8,8,8">
            <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Width="30" Height="30" HorizontalAlignment="Right"
                    ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="CloseDialog_Click"/>
          </Grid>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
          <ContentPresenter x:Name="DialogHost"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
