<UserControl x:Class="TakobotoApp.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,24,28,32"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760"/></Grid.ColumnDefinitions><StackPanel>
      <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,18"/>

      <!-- appearance -->
      <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="24,18,24,20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Theme" FontSize="20" Foreground="{DynamicResource Fg}" Margin="0,0,0,4"/>
          <TextBlock Text="Changes immediately." FontSize="14" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,14"/>
          <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceRadio}" Content="Same as Windows" GroupName="theme" Margin="0,0,0,12" Checked="Theme_Checked"/>
          <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceRadio}" Content="Light" GroupName="theme" Margin="0,0,0,12" Checked="Theme_Checked"/>
          <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceRadio}" Content="Dark" GroupName="theme" Checked="Theme_Checked"/>
        </StackPanel>
      </Border>

      <!-- colour scheme (independent of light / dark) -->
      <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="24,18,24,20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Colour scheme" FontSize="20" Foreground="{DynamicResource Fg}" Margin="0,0,0,4"/>
          <TextBlock Text="The accent colour and the tint of the backgrounds. Works with both the light and the dark theme; changes immediately, the program icon follows." FontSize="14" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <WrapPanel x:Name="SchemePanel"/>
        </StackPanel>
      </Border>

      <!-- languages -->
      <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="24,18,24,20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Additional languages" FontSize="20" Foreground="{DynamicResource Fg}" Margin="0,0,0,4"/>
          <TextBlock Text="Also display and search the following languages (English is always on):" FontSize="14" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <CheckBox x:Name="CheckFrench" Content="French" Margin="0,0,0,12" Checked="Language_Click" Unchecked="Language_Click"/>
          <CheckBox x:Name="CheckGerman" Content="German" Margin="0,0,0,12" Checked="Language_Click" Unchecked="Language_Click"/>
          <CheckBox x:Name="CheckRussian" Content="Russian" Checked="Language_Click" Unchecked="Language_Click"/>
        </StackPanel>
      </Border>

      <!-- storage -->
      <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="24,18,24,20">
        <StackPanel>
          <TextBlock Text="Your data" FontSize="20" Foreground="{DynamicResource Fg}" Margin="0,0,0,4"/>
          <TextBlock Text="Settings, history, favorites and lists are stored in this folder, next to the program:" FontSize="14" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock x:Name="DataPath" FontSize="14" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI" Margin="0,0,0,12"/>
          <Button Style="{StaticResource PillButton}" Content="Open folder" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
