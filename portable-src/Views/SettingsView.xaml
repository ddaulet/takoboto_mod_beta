<UserControl x:Class="TakobotoApp.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13.5">
  <!-- shown in the dialog of the main window (title and close button are there); small groups divided by thin lines -->
  <UserControl.Resources>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>
    <Style x:Key="GroupNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style x:Key="GroupLine" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{DynamicResource Line}"/>
      <Setter Property="Margin" Value="0,12,0,12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,12,20,16">

      <!-- scale -->
      <TextBlock Text="Size of the interface" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="Makes everything smaller or bigger, like the zoom of a browser (also Ctrl + mouse wheel, Ctrl + / Ctrl -, Ctrl 0 for the usual size)." Style="{StaticResource GroupNote}"/>
      <WrapPanel x:Name="ScalePanel"/>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- appearance -->
      <TextBlock Text="Theme" Style="{StaticResource GroupTitle}"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceRadio}" Content="Same as Windows" GroupName="theme" Margin="0,0,20,0" Checked="Theme_Checked"/>
        <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceRadio}" Content="Light" GroupName="theme" Margin="0,0,20,0" Checked="Theme_Checked"/>
        <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceRadio}" Content="Dark" GroupName="theme" Checked="Theme_Checked"/>
      </StackPanel>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- colour scheme (independent of light / dark) -->
      <TextBlock Text="Colour scheme" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="The accent colour and the tint of the backgrounds; works with both themes." Style="{StaticResource GroupNote}"/>
      <WrapPanel x:Name="SchemePanel"/>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- languages -->
      <TextBlock Text="Translation languages" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="French, German and Russian are also searched. Where a word has no translation in the ticked languages, the ones it has are shown." Style="{StaticResource GroupNote}"/>
      <WrapPanel>
        <CheckBox x:Name="CheckEnglish" Content="English" Margin="0,0,20,4" Checked="Language_Click" Unchecked="Language_Click"/>
        <CheckBox x:Name="CheckFrench" Content="French" Margin="0,0,20,4" Checked="Language_Click" Unchecked="Language_Click"/>
        <CheckBox x:Name="CheckGerman" Content="German" Margin="0,0,20,4" Checked="Language_Click" Unchecked="Language_Click"/>
        <CheckBox x:Name="CheckRussian" Content="Russian" Margin="0,0,0,4" Checked="Language_Click" Unchecked="Language_Click"/>
      </WrapPanel>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- example sentences -->
      <TextBlock Text="Example sentences" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="A reading is shown only when it is certain; otherwise the kanji are left without." Style="{StaticResource GroupNote}"/>
      <CheckBox x:Name="CheckFurigana" Content="Furigana: the reading in small kana above the kanji" Checked="Furigana_Click" Unchecked="Furigana_Click"/>

      <!-- grammar -->
      <StackPanel x:Name="GrammarCard" Visibility="Collapsed">
        <Rectangle Style="{StaticResource GroupLine}"/>
        <TextBlock Text="Grammar" Style="{StaticResource GroupTitle}"/>
        <TextBlock Text="The Grammar page always shows Japanese and English." Style="{StaticResource GroupNote}"/>
        <CheckBox x:Name="CheckGrammarChinese" Content="Chinese (explanations and translations)" Checked="GrammarChinese_Click" Unchecked="GrammarChinese_Click"/>
      </StackPanel>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- pronunciation -->
      <TextBlock Text="Pronunciation" Style="{StaticResource GroupTitle}"/>
      <TextBlock x:Name="VoiceInfo" Style="{StaticResource GroupNote}"/>
      <StackPanel x:Name="VoicePanel">
        <TextBlock Text="Voice" FontSize="12.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,4"/>
        <StackPanel x:Name="VoiceList" Margin="0,0,0,8"/>
        <TextBlock Text="Speed" FontSize="12.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,4"/>
        <StackPanel x:Name="SpeedList"/>
      </StackPanel>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- random word -->
      <TextBlock Text="Random word" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="For the dice button in the search box (Ctrl+R). A word counts as common when it has 25 or more example sentences." Style="{StaticResource GroupNote}"/>
      <CheckBox x:Name="CheckRandomCommon" Content="Mostly common words (two of three, now and then any word)" Margin="0,0,0,6" Checked="Random_Click" Unchecked="Random_Click"/>
      <CheckBox x:Name="CheckRandomKatakana" Content="Skip words written in katakana (foreign words)" Checked="Random_Click" Unchecked="Random_Click"/>
      <Rectangle Style="{StaticResource GroupLine}"/>

      <!-- storage -->
      <TextBlock Text="Your data" Style="{StaticResource GroupTitle}"/>
      <TextBlock Text="Settings, history, favorites and lists are stored in this folder, next to the program:" Style="{StaticResource GroupNote}"/>
      <TextBlock x:Name="DataPath" FontSize="12.5" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI" Margin="0,0,0,8"/>
      <Button Style="{StaticResource PillButton}" Content="Open folder" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
