<UserControl x:Class="TakobotoApp.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TakobotoApp">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Grid Margin="28,24,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back to my lists" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
        <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
        <TextBox x:Name="RenameBox" FontSize="22" Width="320" Height="42" Visibility="Collapsed" KeyDown="Rename_KeyDown" LostFocus="Rename_LostFocus"/>
        <Button x:Name="RenameBtn" Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Rename" Click="Rename_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ClearBtn" Style="{StaticResource PillButton}" Content="Clear" Click="Clear_Click" Margin="0,0,8,0"/>
        <Button x:Name="DeleteBtn" Style="{StaticResource PillButton}" Content="Delete list" Click="Delete_Click" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>

    <!-- overview of the user's lists -->
    <ScrollViewer x:Name="Overview" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,6,28,28">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="720"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="OverviewEmpty" Text="You have no lists yet. Create one to keep words together." FontSize="15" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
        <StackPanel x:Name="ListRows"/>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="NewListName" AutomationProperties.Name="New list name" Height="44" FontSize="16" KeyDown="NewList_KeyDown"/>
          <TextBlock x:Name="NewListHint" Text="New list name…" Foreground="{DynamicResource FgFaint}" FontSize="16" VerticalAlignment="Center" Margin="17,0,0,0" IsHitTestVisible="False"/>
          <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Create list" Margin="10,0,0,0" Padding="18,0" Height="44" Click="NewList_Click"/>
        </Grid>
      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- entries -->
    <Grid x:Name="Entries" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" MinWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>
      <Grid>
        <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource WordItemTemplate}" SelectionChanged="List_SelectionChanged"/>
        <TextBlock x:Name="EmptyText" Text="Nothing in this list yet" Visibility="Collapsed" FontSize="16" Foreground="{DynamicResource FgMuted}" Margin="28,12,24,0" VerticalAlignment="Top"/>
      </Grid>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <local:WordView x:Name="Detail"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
