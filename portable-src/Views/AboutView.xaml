<UserControl x:Class="TakobotoApp.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,24,28,32"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760"/></Grid.ColumnDefinitions><StackPanel>
      <TextBlock Text="About Takoboto" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,18"/>
      <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="26,22,26,24">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="Logo" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="18,4,0,0">
              <TextBlock Text="Takoboto" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
              <TextBlock x:Name="VersionText" FontSize="14" Foreground="{DynamicResource FgMuted}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="15.5" Foreground="{DynamicResource Fg}" Margin="0,0,0,14"
                     Text="Takoboto is a Japanese&lt;-&gt;English dictionary and Japanese learning tool."/>
          <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10"
                     Text="The Kanji strokes information are from KanjiVG provided by Ulrich Apel at kanjivg.tagaini.net."/>
          <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10"
                     Text="The dictionary words and kanji come from the JMDict, EDICT and KANJIDIC files owned by the Electronic Dictionary Research and Development Group (www.edrdg.org)."/>
          <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10"
                     Text="The example sentences come from the projects Tatoeba and Tanaka Corpus."/>
          <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,18"
                     Text="Pronunciation (the loudspeaker buttons): speech synthesis by VOICEVOX CORE, voices: VOICEVOX Nemo (voicevox.hiroshiba.jp/nemo). Works offline."/>
          <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,0,0,16"/>
          <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource FgMuted}"
                     Text="This is a portable desktop edition: one folder, no installation. It uses the original Takoboto dictionary engine and data. Keyboard: Ctrl+F or Ctrl+1 search, Ctrl+2 history, Ctrl+3 favorites, Ctrl+4 lists, Ctrl+5 kanji by radicals."/>
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
