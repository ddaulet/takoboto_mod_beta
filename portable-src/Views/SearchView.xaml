<UserControl x:Class="TakobotoApp.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TakobotoApp">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- search box -->
    <Grid Margin="24,22,24,14">
      <TextBox x:Name="Box" AutomationProperties.Name="Search words" Height="50" Padding="48,0,44,0" FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" TextChanged="Box_TextChanged" PreviewKeyDown="Box_KeyDown"/>
      <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" Margin="17,0,0,0" IsHitTestVisible="False"/>
      <TextBlock x:Name="Placeholder" Text="Search Japanese (kanji, kana, romaji) or English, French, German, Russian…" FontSize="16" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" Margin="58,0,44,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="ClearBtn" Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed" Click="Clear_Click" ToolTip="Clear (Esc)" AutomationProperties.Name="Clear search" FontSize="12"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" MinWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource WordItemTemplate}" SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_KeyDown"/>

        <!-- welcome -->
        <StackPanel x:Name="Hint" Margin="28,18,24,0" VerticalAlignment="Top">
          <TextBlock Text="Type a word to start." FontSize="18" Foreground="{DynamicResource Fg}" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,14"
                     Text="Japanese in kanji, kana or romaji, or a word in English, French, German or Russian. Conjugated verbs and adjectives are recognised too."/>
          <TextBlock Text="Try:" FontSize="13.5" Foreground="{DynamicResource FgFaint}" Margin="0,0,0,2"/>
          <WrapPanel x:Name="Examples"/>
        </StackPanel>

        <TextBlock x:Name="NothingFound" Text="Nothing found." Visibility="Collapsed" FontSize="16" Foreground="{DynamicResource FgMuted}" Margin="28,18,24,0" VerticalAlignment="Top"/>

        <!-- how many results; more are loaded automatically while you scroll -->
        <Border x:Name="StatusBar" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
          <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource FgMuted}"/>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

      <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <local:WordView x:Name="Detail"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
