<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme: soft grey-green instead of white, golf green accent (easy on the eyes) -->
  <SolidColorBrush x:Key="PageBg" Color="#E8ECE6"/>
  <SolidColorBrush x:Key="SurfaceBg" Color="#F2F5F0"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#DCE3D9"/>
  <SolidColorBrush x:Key="InputBg" Color="#F5F8F3"/>
  <SolidColorBrush x:Key="Line" Color="#C9D2C6"/>
  <SolidColorBrush x:Key="Fg" Color="#1E2923"/>
  <SolidColorBrush x:Key="FgMuted" Color="#5C6A61"/>
  <SolidColorBrush x:Key="FgFaint" Color="#8A978E"/>
  <SolidColorBrush x:Key="Accent" Color="#2C6E49"/>
  <SolidColorBrush x:Key="AccentFill" Color="#2C6E49"/>
  <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Link" Color="#2F6F9F"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#2B4A3A"/>
  <SolidColorBrush x:Key="SidebarFg" Color="#F0F5EF"/>
  <SolidColorBrush x:Key="SidebarFgMuted" Color="#B9CBBF"/>
  <SolidColorBrush x:Key="SidebarHover" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="SidebarSelected" Color="#36FFFFFF"/>
  <SolidColorBrush x:Key="HoverBg" Color="#E0E7DD"/>
  <SolidColorBrush x:Key="SelectedBg" Color="#D1E1D3"/>
  <SolidColorBrush x:Key="ScrollThumb" Color="#B6C1B3"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#96A593"/>
</ResourceDictionary>
